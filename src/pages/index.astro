---
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';
import { SITE } from '../consts';
import { formatDate, t } from '../i18n';

const works = (await getCollection('works'))
  .sort((a, b) => {
    const byDate = b.data.publishDate.getTime() - a.data.publishDate.getTime();
    return byDate || (a.data.order ?? 999) - (b.data.order ?? 999);
  })
  .slice(0, 3);

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

const site = Astro.site ?? new URL(Astro.url.origin);
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  description: SITE.description,
  url: new URL(withBase('/'), site).href,
};
---

<BaseLayout description={SITE.description}>
  <StructuredData slot="head" schema={websiteSchema} />
  <section class="hero section">
    <p class="eyebrow">前端工程师 · 杭州</p>
    <h1>做实时、AI 驱动的 Web 界面。</h1>
    <p class="lead">
      前端工程师。主导 WhatsApp 商业客户运营平台的前端架构与实时聊天内核,
      关注复杂状态管理、实时通信、AI 前端集成与可复用 UI 系统。
    </p>
    <div class="action-row" aria-label={t('home.primaryLinks')}>
      <a class="button" href={withBase('/works/')}>{t('home.viewWorks')}</a>
      <a class="text-link" href={withBase('/blog/')}>{t('home.readNotes')}</a>
    </div>
  </section>

  <section class="section split-overview" aria-label={t('home.overviewLabel')}>
    <div>
      <p class="eyebrow">关注方向</p>
      <h2>把复杂的状态,放在对的地方。</h2>
    </div>
    <div class="feature-list">
      <article>
        <h3>实时协作</h3>
        <p>
          SSE 长连接、BroadcastChannel 多 Tab 选举、Web Worker 中继、IndexedDB 离线缓存,
          共同支撑一个能承载数千会话、不卡顿的前端实时内核。
        </p>
      </article>
      <article>
        <h3>AI 前端集成</h3>
        <p>
          基于 LangChain + BFF 编排多模型,把 AI 翻译、AI 润色、意图识别与自动打标签
          落到客服工作流里,让模型能力真正变成产品功能。
        </p>
      </article>
      <article>
        <h3>可复用 UI</h3>
        <p>
          自研 Yiawa UI、@roogoo/rg-ui 两套组件库,搭配 TailwindCSS、Ant Design 主题与设计 token,
          把可被多个项目复用的工程资产沉淀下来。
        </p>
      </article>
    </div>
  </section>

  <section class="section index-feed" aria-labelledby="latest-works">
    <div class="section-heading">
      <p class="eyebrow">{t('home.latestWorksEyebrow')}</p>
      <h2 id="latest-works">主要项目。</h2>
      <a class="text-link" href={withBase('/works/')}>{t('home.allWorks')}</a>
    </div>

    {
      works.length > 0 ? (
        <div class="highlight-grid">
          {works.map((work) => (
            <article class="highlight-card">
              {work.data.thumbnail && (
                <Image src={work.data.thumbnail} alt="" width={720} height={480} loading="lazy" />
              )}
              <div>
                <p class="meta">{formatDate(work.data.publishDate, 'short')}</p>
                <h3>
                  <a href={withBase(`/works/${work.id}/`)}>{work.data.title}</a>
                </h3>
                <p>{work.data.description}</p>
                {work.data.tech.length > 0 && (
                  <ul class="tag-list" aria-label={t('home.workTech', { title: work.data.title })}>
                    {work.data.tech.slice(0, 4).map((tech) => (
                      <li>{tech}</li>
                    ))}
                  </ul>
                )}
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state compact">
          <p set:html={t('home.worksEmpty')} />
        </div>
      )
    }
  </section>

  <section class="section index-feed" aria-labelledby="latest-notes">
    <div class="section-heading">
      <p class="eyebrow">{t('home.latestBlogEyebrow')}</p>
      <h2 id="latest-notes">最近在写。</h2>
      <a class="text-link" href={withBase('/blog/')}>{t('home.allPosts')}</a>
    </div>

    {
      posts.length > 0 ? (
        <div class="note-list">
          {posts.map((post) => (
            <article class="note-row">
              {post.data.heroImage && (
                <Image src={post.data.heroImage} alt="" width={320} height={220} loading="lazy" />
              )}
              <div>
                <p class="meta">{formatDate(post.data.publishDate, 'short')}</p>
                <h3>
                  <a href={withBase(`/blog/${post.id}/`)}>{post.data.title}</a>
                </h3>
                <p>{post.data.description}</p>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state compact">
          <p set:html={t('home.postsEmpty')} />
        </div>
      )
    }
  </section>
</BaseLayout>
