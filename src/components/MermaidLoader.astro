---
// 客户端 Mermaid loader。模板默认零 JS,只有 blog 文章里出现 ```mermaid
// 代码块时,这个组件才把 Mermaid 库动态 import 进来,渲染 SVG 替换代码块。
// 渲染后会被 view-transition 路由器重新挂载,所以监听 astro:after-swap 重建。
---

<script>
  const renderMermaid = async () => {
    // Astro 7 + Shiki 把语言标识放在 <pre data-language="..."> 上,
    // 不是 <code class="language-...">。这里按 data 属性匹配。
    const blocks = document.querySelectorAll<HTMLPreElement>(
      'pre[data-language="mermaid"]',
    );
    if (blocks.length === 0) return;

    const { default: mermaid } = await import('mermaid');
    const isDark =
      document.documentElement.dataset.theme === 'dark' ||
      (document.documentElement.dataset.theme === undefined &&
        window.matchMedia('(prefers-color-scheme: dark)').matches);

    mermaid.initialize({
      startOnLoad: false,
      theme: isDark ? 'dark' : 'default',
      securityLevel: 'strict',
      fontFamily: 'inherit',
    });

    for (const [i, pre] of blocks.entries()) {
      const code = pre.querySelector('code');
      const source = code?.textContent ?? pre.textContent ?? '';
      const id = `mermaid-${Date.now()}-${i}`;
      try {
        const { svg } = await mermaid.render(id, source);
        const wrapper = document.createElement('div');
        wrapper.className = 'mermaid-diagram';
        wrapper.setAttribute('data-pagefind-ignore', '');
        wrapper.innerHTML = svg;
        pre.replaceWith(wrapper);
      } catch (err) {
        console.error('[mermaid] render failed:', err);
      }
    }
  };

  // 初次加载,以及 view-transition 软导航后都重新执行。
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', renderMermaid);
  } else {
    renderMermaid();
  }
  document.addEventListener('astro:after-swap', renderMermaid);
</script>
